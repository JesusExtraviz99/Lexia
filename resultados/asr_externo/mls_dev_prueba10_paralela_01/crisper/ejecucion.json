        "file_bytes": 226102,
        "frames": 203040,
        "sample_rate": 16000,
        "audio_seconds": 12.69,
        "reference": "calle señor bueno replicó el cartero que no hubo encanto alguno ni mudanza de rostro ninguna tan lacayo tosilos entré en la estacada como tosilos lacayo salí della"
      },
      {
        "id": "3719_1378_000049",
        "speaker_id": "3719",
        "book_id": "1378",
        "file": "dev/audio/3719/1378/3719_1378_000049.flac",
